<Description>
<![CDATA[Bit address state indicator for certain more limited HMIs]]>
</Description>
<Comments>
<Comment Operand=".0">
<![CDATA[running]]>
</Comment>
<Comment Operand=".1">
<![CDATA[complete]]>
</Comment>
<Comment Operand=".2">
<![CDATA[pausing]]>
</Comment>
<Comment Operand=".3">
